# Copy to .env.local for local dev, or add each key in
# Netlify: Site configuration > Environment variables.

# Required: TMDB v3 API key (https://www.themoviedb.org/settings/api)
# Read on the server only; never exposed to the browser.
TMDB_API_KEY=

# Optional: session cookie for Moctale reviews on title pages.
# Leave empty to hide those reviews.
MOCTALE_COOKIE=
